{
  "name": "kanbun-typesetter",
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && npm run build:lib",
    "test": "node --import tsx --test tests/parser.test.ts tests/layout.test.ts",
    "test:browser": "playwright test",
    "test:visual": "playwright test --update-snapshots",
    "build:lib": "tsc -p tsconfig.lib.json && node scripts/copy-library-assets.mjs",
    "prepack": "npm run build",
    "pack:check": "node scripts/check-package.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepublishOnly": "npm run check:release && npm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./react": {
      "types": "./dist/lib/react/index.d.ts",
      "import": "./dist/lib/react/index.js"
    },
    "./styles.css": "./dist/lib/html/styles.css",
    "./html": {
      "types": "./dist/lib/html/index.d.ts",
      "import": "./dist/lib/html/index.js"
    }
  },
  "description": "Kanbun kundoku typesetting with a standalone HTML renderer and React component.",
  "keywords": [
    "kanbun",
    "kundoku",
    "furigana",
    "okurigana",
    "typescript",
    "react",
    "typography"
  ],
  "files": [
    "dist/lib",
    "README*.md",
    "src/html/README.md",
    "src/react/README.md",
    "LICENSE"
  ],
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
